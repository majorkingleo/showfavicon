#!/usr/bin/env python3
"""Download the favicon of a website, cache it, and report the result as JSON.

Usage:
    showfavicon-fetch <url> [cache-dir]

One JSON object is printed on a single line of stdout:

    {"site": "...", "ok": true,
     "file": "/abs/color.png", "grayFile": "/abs/gray.png",
     "hash": "...", "error": ""}

`ok` is false when the site could not be reached; the cached files from the last
successful run are still reported (or null when nothing was ever cached), so the
widget can show the previous icon dimmed instead of an empty cell.

The standard library does all the HTTP and HTML work. ImageMagick (`magick`) is
used when present to normalise the icon to PNG and to build the grayscale copy
for the offline state; without it the raw bytes are cached instead, `grayFile`
stays null and the widget falls back to dimming the icon with opacity.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
from html.parser import HTMLParser

TIMEOUT = 15
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) ShowFavicon/1.0"
ICON_REL_RANK = {"icon": 0, "shortcut icon": 1, "apple-touch-icon": 2, "mask-icon": 3}


class LinkParser(HTMLParser):
    """Collects <link> tags whose rel attribute mentions an icon."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.links = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() != "link":
            return
        attributes = {key.lower(): (value or "") for key, value in attrs}
        rel = attributes.get("rel", "").strip().lower()
        href = attributes.get("href", "").strip()
        if href and "icon" in rel:
            self.links.append((rel, href))


def with_scheme(url):
    """Prepend https:// when the user typed a bare host."""
    if not re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://", url):
        return "https://" + url
    return url


def cache_key(url):
    """A stable, filesystem-safe name for the cache files of one site."""
    host = urllib.parse.urlsplit(url).hostname or "site"
    safe_host = re.sub(r"[^A-Za-z0-9._-]", "_", host)
    digest = hashlib.sha1(url.encode("utf-8")).hexdigest()[:8]
    return "%s-%s" % (safe_host, digest)


def default_cache_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(base, "showfavicon")


def http_get(url, accept):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": accept})
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return response.read(), response.geturl()


def pick_icon_url(page_bytes, base_url):
    """The best icon URL advertised by the page, or /favicon.ico as fallback."""
    parser = LinkParser()
    try:
        parser.feed(page_bytes.decode("utf-8", "replace"))
    except Exception:
        pass

    def rank(link):
        rel = link[0]
        if rel in ICON_REL_RANK:
            return ICON_REL_RANK[rel]
        return 10

    links = sorted(parser.links, key=rank)
    if links:
        return urllib.parse.urljoin(base_url, links[0][1])
    return urllib.parse.urljoin(base_url, "/favicon.ico")


def find_converter():
    return shutil.which("magick") or shutil.which("convert")


def normalize(raw, color_path, gray_path):
    """Write a PNG colour copy and a grayscale copy. False when impossible."""
    converter = find_converter()
    if converter is None:
        return False

    handle, temp_path = tempfile.mkstemp(prefix="showfavicon-", suffix=".img")
    try:
        with os.fdopen(handle, "wb") as temp_file:
            temp_file.write(raw)
        # [0] selects the first frame, which matters for multi-size .ico files.
        subprocess.run(
            [converter, temp_path + "[0]", "-background", "none", "-resize", "128x128", color_path],
            check=True, capture_output=True,
        )
        subprocess.run(
            [converter, color_path, "-colorspace", "Gray", "-alpha", "on", gray_path],
            check=True, capture_output=True,
        )
        return True
    except Exception:
        try:
            os.remove(color_path)
        except OSError:
            pass
        return False
    finally:
        try:
            os.remove(temp_path)
        except OSError:
            pass


def digest_of(path):
    with open(path, "rb") as handle:
        return hashlib.sha1(handle.read()).hexdigest()


def build_result(url, cache_dir):
    key = cache_key(url)
    color_path = os.path.join(cache_dir, key + ".png")
    gray_path = os.path.join(cache_dir, key + ".gray.png")
    raw_path = os.path.join(cache_dir, key + ".bin")

    result = {"site": url, "ok": False, "file": None, "grayFile": None, "hash": None, "error": ""}

    try:
        icon_url = urllib.parse.urljoin(url, "/favicon.ico")
        try:
            page_bytes, final_url = http_get(url, "text/html,application/xhtml+xml,*/*;q=0.8")
            icon_url = pick_icon_url(page_bytes, final_url)
        except Exception as error:
            # The page may refuse us while the icon is still reachable.
            result["error"] = "page: %s" % error

        raw, _content_type = http_get(icon_url, "image/*,*/*;q=0.8")
        if not raw:
            raise ValueError("empty favicon")

        if normalize(raw, color_path, gray_path):
            return dict(result, ok=True, file=color_path, grayFile=gray_path, hash=digest_of(color_path))

        # No converter available: cache the raw bytes; the widget dims them itself.
        with open(raw_path, "wb") as handle:
            handle.write(raw)
        return dict(result, ok=True, file=raw_path, grayFile=None,
                    hash=hashlib.sha1(raw).hexdigest(), error="no image converter found")
    except Exception as error:
        # Keep the last good icon: report the files that are already cached.
        message = str(error) or error.__class__.__name__
        # The page request and the icon request usually fail with the same text
        # when the site is simply unreachable.
        if message not in result["error"]:
            result["error"] = (result["error"] + "; " + message).strip("; ")
        for candidate, field in ((color_path, "file"), (raw_path, "file"), (gray_path, "grayFile")):
            if os.path.exists(candidate) and result[field] is None:
                result[field] = candidate
        if result["file"] is not None:
            try:
                result["hash"] = digest_of(result["file"])
            except OSError:
                pass
        return result


def main(argv):
    if len(argv) < 2 or not argv[1].strip():
        print(json.dumps({"site": "", "ok": False, "file": None, "grayFile": None,
                          "hash": None, "error": "no url given"}))
        return 0

    url = with_scheme(argv[1].strip())
    cache_dir = argv[2].strip() if len(argv) > 2 and argv[2].strip() else default_cache_dir()
    try:
        os.makedirs(cache_dir, exist_ok=True)
    except OSError as error:
        print(json.dumps({"site": url, "ok": False, "file": None, "grayFile": None,
                          "hash": None, "error": "cache dir: %s" % error}))
        return 0

    print(json.dumps(build_result(url, cache_dir)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
